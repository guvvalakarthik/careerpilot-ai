{
  "name": "careerpilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run db:seed && playwright test",
    "db:up": "docker compose up -d",
    "db:validate": "prisma validate",
    "db:migrate": "tsx scripts/run-local-prisma.ts migrate dev",
    "db:deploy:local": "tsx scripts/run-local-prisma.ts migrate deploy",
    "db:status:local": "tsx scripts/run-local-prisma.ts migrate status",
    "db:drift:local": "tsx scripts/run-local-prisma.ts migrate diff --exit-code --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma",
    "db:seed": "tsx scripts/run-local-prisma.ts db seed",
    "db:studio": "tsx scripts/run-local-prisma.ts studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@google/genai": "^2.13.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.68.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.26.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.0",
    "resend": "^6.18.0",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
