# --- Database ---
# Local dev (Docker Compose): postgresql://careerpilot:careerpilot_dev@localhost:5434/careerpilot
# Production: use your Neon connection string
DATABASE_URL="postgresql://careerpilot:careerpilot_dev@localhost:5434/careerpilot"

# --- Auth.js ---
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (Week 3+) ---
# Gemini API key (https://aistudio.google.com/apikey) - free tier
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Background jobs (Week 3+) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Storage (Week 6) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="careerpilot-documents"

# --- Cron (Week 7) ---
CRON_SECRET=""

# --- Monitoring ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Rate limiting (Week 8) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
