# --- Database ---
# Application connection. Keep production credentials in the hosting platform, not local files.
DATABASE_URL="postgresql://careerpilot:careerpilot_dev@localhost:5434/careerpilot"
# Guarded db:* scripts prefer this value and reject non-loopback hosts.
LOCAL_DATABASE_URL="postgresql://careerpilot:careerpilot_dev@localhost:5434/careerpilot"

# --- Auth.js ---
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical application URL used by Auth.js in production
AUTH_URL="http://localhost:3000"
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (Week 3+) ---
# Gemini API key (https://aistudio.google.com/apikey) - free tier
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Retrieval-augmented generation ---
# Keep disabled in production until the pgvector migration is separately approved.
RAG_ENABLED="false"
RAG_EMBEDDING_MODEL="gemini-embedding-001"

# --- Email (Resend) ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CareerPilot AI <noreply@yourdomain.com>"

# --- Background jobs (Week 3+) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Storage (Week 6) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="careerpilot-documents"

# --- Cron (Week 7) ---
CRON_SECRET=""

# --- Monitoring ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional performance trace sampling rates, from 0 to 1
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Required together during production builds to upload source maps
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Rate limiting (required in production; in-memory fallback is dev/test only) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
